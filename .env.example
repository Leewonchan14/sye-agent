# ============================================
# Required
# ============================================

# 로그인 세션 서명 키 (Better Auth) — openssl rand -base64 32
BETTER_AUTH_SECRET=

# 사이트 주소 — 로컬: http://localhost:3000, 배포: https://<도메인>
BETTER_AUTH_URL=http://localhost:3000

# DB 연결 문자열 — Neon, 로컬 Postgres, 또는 PGlite(pglite:./.pglite — 서버 프로세스 안에 파일로 저장)
# Neon: Vercel Marketplace → Neon → Create → 프로젝트 연결 시 자동 설정됨
# 형식: postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Hermes API 서버 base URL — 프로필 프리픽스(/p/monitor)까지 포함, 끝 슬래시 없이
#  · 배포: http(s)://<hermes-host>:8642/p/monitor
#  · 로컬(권장): SSH 터널 — ssh -N -L 8642:127.0.0.1:8642 <hermes-host>
#                → http://127.0.0.1:8642/p/monitor
#  · 로컬(목 서버): http://127.0.0.1:8971/p/monitor (scripts/mock-hermes-server.mjs)
HERMES_API_URL=

# 서빙 프로필 전용 API_SERVER_KEY — 게이트웨이 쪽 값과 앱 쪽 값이 서로 다릅니다.
#
#  [1] Hermes 게이트웨이(멀티플렉스) 설정
#      · 공유 리스너(기본 127.0.0.1:8642)는 "default 프로필"이 소유한다. ~/.hermes/.env:
#          API_SERVER_ENABLED=true
#          API_SERVER_KEY=<default용 랜덤 값, 예: openssl rand -hex 32>
#          API_SERVER_HOST=0.0.0.0     # 외부(Vercel 등)에서 접속할 때만. 기본은 127.0.0.1
#        재시작: systemctl --user restart hermes-gateway.service
#        확인  : ss -ltn | grep 8642
#      · 서빙 프로필(monitor)은 /p/monitor 경로의 인증만 담당한다(자체 리스너는 열지 않음).
#        ~/.hermes/profiles/monitor/.env:
#          API_SERVER_KEY=<서빙 프로필용 랜덤 값>    # default 키와 반드시 다른 값
#        키는 16자 이상이어야 한다(짧으면 게이트웨이가 API 서버 기동을 거부).
#
#  [2] 앱(여기)에는 서빙 프로필 키를 넣는다. /p/monitor/* 는 서빙 프로필 키만 통과하고 default 키는 401이다.
#
#  [3] API_SERVER_HOST=0.0.0.0 으로 열었다면 호스트 방화벽도 함께 연다.
#      Oracle 이미지 기본 규칙은 마지막이 REJECT라 그 "앞"에 넣어야 한다:
#        sudo iptables -I INPUT 6 -p tcp -m state --state NEW --dport 8642 -j ACCEPT
#        sudo netfilter-persistent save      # 재부팅 후에도 유지
#      그리고 OCI VCN Security List(또는 NSG)에 TCP 8642 수신 규칙을 추가한다.
#      ⚠ 이 엔드포인트는 터미널 실행 권한을 가진 에이전트다 — 노출 시 Bearer 키가 유일한 방어선이다.
HERMES_API_KEY=

# ============================================
# Optional
# ============================================

# 서비스 이름 (기본 AI 어시스턴트)
# NEXT_PUBLIC_APP_NAME=AI 어시스턴트

# 앱 세션 ID → Hermes 세션 ID 프리픽스 (기본 app-)
# HERMES_SESSION_PREFIX=app-

# 장기 기억 스코프(X-Hermes-Session-Key) 접두사 (기본 app) — 실제 값은 <접두사>:user:<userId>로 사용자마다 갈린다
# HERMES_SESSION_KEY=app

# 모든 대화에 덧붙일 운영자 지시 (선택)
HERMES_SYSTEM_MESSAGE=

# 채팅 스트림을 서버가 스스로 닫는 시각(ms) — Vercel 함수 한도(기본 300s)보다 짧게 (기본 240000)
# 그 시점에 브라우저는 커서를 들고 /api/chat/{sessionId}/stream 으로 이어받는다 (런은 계속 산다)
# CHAT_SOFT_DEADLINE_MS=240000

# OG 태그에 쓰는 사이트 도메인
# 미설정 시: Vercel production → VERCEL_PROJECT_PRODUCTION_URL, 그 외 Vercel → VERCEL_URL, 로컬 → localhost:3000
# NEXT_PUBLIC_SITE_URL=https://<프로젝트>.vercel.app

# 로그인·가입 요청 제한을 끈다 — e2e 테스트 서버에서만 (기본 켜짐)
# AUTH_RATE_LIMIT=off

# ============================================
# Dev — mock Hermes 전용 (scripts/mock-hermes-server.mjs 프로세스용, 앱에는 불필요)
# ============================================

# 목 서버 베어러 키 (기본 mock-key)
# MOCK_HERMES_API_KEY=mock-key

# 1로 설정하면 세션당 첫 chat/stream 요청을 429로 거절 (재시도 로직 확인용)
# MOCK_429_FIRST=1

# ─── 언론 모니터링 대시보드 (/monitor) ───
# Hermes 모니터링 스킬이 /api/monitor/agent/* 로 결과를 보낼 때 쓰는 키 (x-monitor-key 헤더).
# Hermes 서빙 프로필 .env에도 같은 값을 넣는다. 자세한 형식은 docs/monitor-agent.md
MONITOR_INGEST_KEY=
# Hermes(도커 터미널)에서 앱으로 닿는 주소가 공개 주소와 다를 때만 (예: 로컬 테스트 http://172.17.0.1:8790)
# MONITOR_CALLBACK_ORIGIN=
