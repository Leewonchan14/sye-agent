# ============================================
# Required
# ============================================

# 사이트 접속 비밀번호 (웹 로그인 게이트 + API 토큰 서명에 사용)
# 예: SITE_PASSWORD=0411
SITE_PASSWORD=

# DB 연결 문자열 — Neon(권장) 또는 로컬 Postgres
# Neon: Vercel Marketplace → Neon → Create → 프로젝트 연결 시 자동 설정됨
# 형식: postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Hermes API 서버 base URL — 프로필 프리픽스(/p/hachi)까지 포함, 끝 슬래시 없이
#  · 배포: 터널로 노출한 주소 + /p/hachi (예: https://hermes.example.com/p/hachi)
#  · 로컬: 목 서버를 쓸 때 http://127.0.0.1:8971/p/hachi (scripts/mock-hermes-server.mjs)
HERMES_API_URL=

# hachi 프로필 전용 API_SERVER_KEY — 아래 2곳에 "같은 값"을 넣습니다.
#  1) hachi 쪽 ~/.hermes/profiles/hachi/.env 에 추가 후 게이트웨이 재시작:
#       API_SERVER_ENABLED=true
#       API_SERVER_KEY=<랜덤 값, 예: openssl rand -hex 32>
#  2) 앱(여기)에도 1)과 같은 값:
# 멀티플렉스 /p/hachi 경로는 hachi 자신의 키만 통과합니다 (기본 프로필 키는 거부됨).
HERMES_API_KEY=

# ============================================
# Optional
# ============================================

# 앱 세션 ID → Hermes 세션 ID 프리픽스 (기본 sye-)
# HERMES_SESSION_PREFIX=sye-

# 장기 기억 스코프(X-Hermes-Session-Key) — 웹앱 대화를 하나의 사용자로 취급 (기본 sye-agent)
# HERMES_SESSION_KEY=sye-agent

# 매 요청 system_message 끝에 덧붙일 문구 (선택)
# HERMES_SYSTEM_MESSAGE=

# OG 태그에 쓰는 사이트 도메인
# 미설정 시: Vercel production → VERCEL_PROJECT_PRODUCTION_URL, 그 외 Vercel → VERCEL_URL, 로컬 → localhost:3000
# NEXT_PUBLIC_SITE_URL=https://trable-agent.vercel.app

# 커플 시작일 — D-day 계산에 사용 (기본 2026-04-11)
# NEXT_PUBLIC_COUPLE_START_DATE=2026-04-11

# ============================================
# Dev — mock Hermes 전용 (scripts/mock-hermes-server.mjs 프로세스용, 앱에는 불필요)
# ============================================

# 목 서버 베어러 키 (기본 mock-key)
# MOCK_HERMES_API_KEY=mock-key

# 1로 설정하면 세션당 첫 chat/stream 요청을 429로 거절 (재시도 로직 확인용)
# MOCK_429_FIRST=1
