# ============================================
# Required
# ============================================

# Site access password (접속 비밀번호)
# 예: SITE_PASSWORD=0411
SITE_PASSWORD=

# DeepSeek API Key (DeepSeek 공식 API 사용 시)
# 발급: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenCode Go API Key — 여러 개면 콤마·세미콜론·줄바꿈으로 구분 (한도 소진 시 자동 로테이션)
# 발급: https://opencode.ai/docs/go/
OPENCODE_GO_API_KEYS=

# 단일 키만 쓸 때 (위 목록 변수가 없으면 이 변수를 사용)
OPENCODE_GO_API_KEY=

# OpenCode Zen API Key — 목록 변수 미설정 시 OpenCode Go 키를 폴백으로 사용
# 발급: https://opencode.ai/docs/zen/
OPENCODE_ZEN_API_KEYS=
OPENCODE_ZEN_API_KEY=

# Vercel Neon DB (Vercel Marketplace → Neon → Create → 연결)
# 형식: postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ============================================
# Naver Search API
# ============================================
# 발급: https://developers.naver.com/apps/#/register → "검색" API 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================================
# Playwright MCP (브라우저 도구)
# ============================================
# 원격 Playwright MCP 서버 (Caddy bearer 인증 프록시)
PLAYWRIGHT_MCP_URL=
PLAYWRIGHT_MCP_TOKEN=

# ============================================
# Sandbox MCP (원격 샌드박스)
# ============================================
# 원격 샌드박스 MCP 서버 (Caddy bearer 인증 프록시)
SANDBOX_MCP_URL=
SANDBOX_MCP_TOKEN=

# ============================================
# Optional
# ============================================

# 사이트 도메인 (OG 태그 이미지 URL에 사용)
# 설정하지 않으면 Vercel 배포 시 VERCEL_URL을, 로컬 개발 시 localhost를 자동 사용
# NEXT_PUBLIC_SITE_URL=https://trable-agent.vercel.app

